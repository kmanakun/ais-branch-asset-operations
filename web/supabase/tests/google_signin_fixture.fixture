-- Keep unrelated database tests representative of the production Google
-- allow-list: each synthetic Auth user must be pre-approved before creation.
create or replace function pg_temp.create_test_google_user(
  p_user_id uuid,
  p_email text,
  p_role app_private.app_role default 'field_technician',
  p_display_name text default 'Test account'
)
returns void
language plpgsql
set search_path = ''
as $$
begin
  insert into app_private.google_signin_allowlist (email, role, display_name, is_active)
  values (lower(btrim(p_email)), p_role, p_display_name, true)
  on conflict (email) do update
    set role = excluded.role,
        display_name = excluded.display_name,
        is_active = true;

  insert into auth.users (
    id, aud, role, email, encrypted_password, email_confirmed_at,
    raw_app_meta_data, created_at, updated_at
  )
  values (
    p_user_id, 'authenticated', 'authenticated', lower(btrim(p_email)), '',
    now(), '{"provider":"google","providers":["google"]}'::jsonb, now(), now()
  )
  on conflict (id) do nothing;
end
$$;
