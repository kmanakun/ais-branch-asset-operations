{
  "name": "ais-branch-asset-operations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:d1": "wrangler pages dev dist --d1=DB=local-ais-scanner-db",
    "build": "tsc -b && vite build && node scripts/configure-csp-headers.mjs && node scripts/clean-stale-build-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty",
    "test:xlsx": "node --test scripts/xlsx-register.test.mjs",
    "test:d1": "node --test scripts/d1-api.test.mjs",
    "test:e2e": "node scripts/test-live-flow.mjs",
    "test:all": "npm run test:xlsx && npm run test:d1 && npm run test:e2e",
    "deploy": "wrangler pages deploy dist --project-name ais-branch-asset-operations --branch main"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "hono": "^4.13.18",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "wrangler": "^4.158.0"
  }
}
