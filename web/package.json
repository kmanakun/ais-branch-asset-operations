{
  "name": "ais-branch-asset-operations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:d1": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "build": "tsc -b && vite build && node scripts/configure-csp-headers.mjs && node scripts/clean-stale-build-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty",
    "test:xlsx": "node --test scripts/xlsx-register.test.mjs",
    "test:d1": "node --test scripts/d1-api.test.mjs scripts/d1-stock.test.mjs",
    "test:e2e": "node scripts/test-live-flow.mjs",
    "cleanup:e2e": "node scripts/cleanup-e2e.mjs",
    "backup:r2": "node scripts/backup-r2-evidence.mjs",
    "test:all": "npm run test:xlsx && npm run test:d1 && npm run test:e2e",
    "deploy": "wrangler pages deploy dist --project-name ais-branch-asset-operations --branch main"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.18",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "wrangler": "^4.158.0"
  }
}
