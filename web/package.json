{
  "name": "ais-branch-asset-operations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/configure-csp-headers.mjs && node scripts/clean-stale-build-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty",
    "test:xlsx": "node --test scripts/xlsx-register.test.mjs",
    "test:app": "node --test scripts/app-flow.test.mjs",
    "test:db": "supabase test db",
    "test:all": "npm run test:xlsx && npm run test:app && npm run test:db"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "supabase": "^3.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "wrangler": "^4.158.0"
  }
}
