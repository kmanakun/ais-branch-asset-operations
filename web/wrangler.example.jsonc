{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ais-branch-asset-operations",
  "compatibility_date": "2026-11-07",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ais-scanner-db",
      "database_id": "<your-d1-database-id>"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "ais-scanner-evidence"
    }
  ]
}
