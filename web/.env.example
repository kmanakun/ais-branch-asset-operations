# Optional Cloudflare Pages local dev environment variables.
# Copy to .dev.vars or .env.local only when testing real Google OAuth locally.
# Leaving these unset keeps Localhost Dev Auth Switcher enabled on 127.0.0.1.
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET
